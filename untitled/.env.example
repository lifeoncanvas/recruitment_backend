# LICHT Backend Environment Configuration Template
# Copy this file to .env or configure in your deployment environment / IDE Run Configuration

# Neon PostgreSQL Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# Super Administrator Credentials (REQUIRED - the app will not start without ADMIN_PASSWORD, min 12 chars)
ADMIN_EMAIL=admin@lichtrecruitmentservices.com
ADMIN_PASSWORD=<strong-random-admin-password>

# Cryptographic Token Secret (REQUIRED - HMAC-SHA256, minimum 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<strong-random-secret-key-at-least-32-chars>

# Allowed CORS Origins (comma separated). In production set this to your real site address(es), e.g.
# CORS_ALLOWED_ORIGINS=https://lichtrecruitmentservices.com,https://www.lichtrecruitmentservices.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Set to true ONLY when running behind a reverse proxy/load balancer that sets X-Forwarded-For
TRUST_PROXY=false

# Port the server listens on. Most hosts set PORT themselves; defaults to 8080
# PORT=8080

# Where uploaded CVs and employer documents are kept: local (server disk) or s3 (cloud bucket).
# Use s3 on hosts that wipe the disk on every redeploy (Render, Railway, Heroku, most containers).
STORAGE_TYPE=local

# STORAGE_TYPE=local: folder on the server (not publicly served; downloaded via authorised API endpoints)
UPLOAD_DIR=uploads

# STORAGE_TYPE=s3: a PRIVATE bucket (never enable public access). Works with AWS S3, Cloudflare R2, Backblaze B2.
# S3_ENDPOINT is only needed for non-AWS providers, e.g. https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Local development only: create demo candidate/employer logins on an empty database
SEED_DEMO_ACCOUNTS=false
